---
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const baseRoot = base.replace(/\/$/, '');
const path = Astro.url.pathname.startsWith(baseRoot)
	? Astro.url.pathname.slice(baseRoot.length) || '/'
	: Astro.url.pathname;

const navItems = [
	{ label: '品牌规范', slug: 'brand' },
	{ label: '素材归档', slug: 'assets' },
	{ label: '应用规范', slug: 'guidelines' },
	{ label: '周边设计', slug: 'merch' },
];

const hrefFor = (slug: string) => `${base}${slug}/`;
const isActive = (slug: string) => path === `/${slug}` || path.startsWith(`/${slug}/`);
---

<div class="vis-header">
	<div class="vis-title sl-flex">
		<a class="vis-site-title" href={base} aria-label="南工问天 VIS 首页">
			<span class="vis-lockup-frame vis-lockup-frame-dark">
				<img class="vis-lockup" src={`${base}assets/brand/team-lockup/队标加字反白.svg`} alt="南工问天 VIS" />
			</span>
			<span class="vis-lockup-frame vis-lockup-frame-light">
				<img class="vis-lockup" src={`${base}assets/brand/team-lockup/队标加字.svg`} alt="南工问天 VIS" />
			</span>
			<span class="vis-title-divider" aria-hidden="true"></span>
			<span class="vis-title-system">
				<span class="vis-title-system-zh">视觉形象识别系统</span>
				<span class="vis-title-system-en">VISUAL IDENTITY SYSTEM</span>
			</span>
		</a>
	</div>
	<nav class="vis-nav" aria-label="主要导航">
		{navItems.map((item) => (
			<a class="mdc-ripple-surface" href={hrefFor(item.slug)} aria-current={isActive(item.slug) ? 'page' : undefined}>
				{item.label}
			</a>
		))}
	</nav>
	<div class="vis-tools sl-flex print:hidden">
		<Search />
		<div class="vis-theme"><ThemeSelect /></div>
	</div>
</div>

<style>
	@layer starlight.core {
		.vis-header {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr) auto;
			gap: clamp(0.75rem, 2vw, 2rem);
			height: 100%;
		}
		.vis-title { min-width: 0; }
		.vis-site-title { display: inline-flex; align-items: center; column-gap: 0.3em; width: auto; height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y)); min-width: 0; text-decoration: none; white-space: nowrap; }
		.vis-lockup-frame { display: block; flex: 0 0 auto; height: 100%; aspect-ratio: 351.387321 / 85.010791; }
		.vis-lockup-frame-light { display: none; }
		.vis-lockup { display: block; width: 100%; height: 100%; object-fit: contain; }
		:global(:root[data-theme='light']) .vis-lockup-frame-dark { display: none; }
		:global(:root[data-theme='light']) .vis-lockup-frame-light { display: block; }
		.vis-title-divider { flex: 0 0 1px; width: 1px; height: calc(100% - 0.25rem); background: var(--vis-border-strong);}
		.vis-title-system { display: inline-flex; flex-direction: column; align-items: stretch; justify-content: center; gap: 0.15rem; width: max-content; max-width: none; height: 100%; color: var(--vis-header-muted); font-size: 1.05rem; font-weight: 700; line-height: 1.2; white-space: nowrap;}
		.vis-title-system-zh, .vis-title-system-en { display: block; width: 100%; }
		.vis-title-system-zh { line-height: 1.1; }
		.vis-title-system-en { font-size: 55%; line-height: 1; letter-spacing: 0.02em; text-align: justify; text-align-last: justify; }
		.vis-nav {
			display: flex;
			justify-content: center;
			gap: clamp(0.45rem, 1.6vw, 1.5rem);
			min-width: 0;
		}
		.vis-nav a {
			position: relative;
			padding: 0.45rem 0.15rem;
			color: var(--vis-header-muted);
			background-image: linear-gradient(var(--vis-orange), var(--vis-orange));
			background-repeat: no-repeat;
			background-position: center 100%;
			background-size: 0 2px;
			font-size: 0.84rem;
			font-weight: 700;
			text-decoration: none;
			white-space: nowrap;
			transition: color var(--vis-motion-fast) ease, background-size var(--vis-motion-fast) var(--vis-ease-out);
		}
		.vis-nav a:hover,
		.vis-nav a:focus-visible,
		.vis-nav a[aria-current='page'] { color: var(--vis-orange); }
		.vis-nav a:hover,
		.vis-nav a:focus-visible,
		.vis-nav a[aria-current='page'] { background-size: calc(100% - 0.3rem) 2px; }
		@media (hover: none) {
			.vis-nav a:hover:not([aria-current='page']) { color: var(--vis-header-muted); background-size: 0 2px; }
		}
		.vis-tools { gap: 0.75rem; align-items: center; }
		.vis-tools :global(site-search button[data-open-modal]) { color: var(--vis-header-muted); }
		@media (max-width: 72rem) {
			.vis-header { grid-template-columns: auto minmax(0, 1fr) auto; gap: 0.75rem; }
			.vis-nav { justify-content: flex-start; overflow-x: auto; scrollbar-width: none; }
			.vis-nav::-webkit-scrollbar { display: none; }
			.vis-theme { display: none; }
		}
		@media (max-width: 50rem) {
			.vis-header { grid-template-columns: minmax(0, 1fr) auto; }
			.vis-nav { display: none; }
			.vis-tools { grid-column: 2; grid-row: 1; }
		}
	}
</style>

<style is:global>
	@layer starlight.core {
		/* Starlight renders the menu toggle outside the custom header. Keep it on the nav's trailing edge. */
		@media (max-width: 50rem) {
			starlight-menu-button button {
				inset-inline-start: auto !important;
				inset-inline-end: var(--sl-nav-pad-x) !important;
			}
		}
		@media (min-width: 50rem) {
			site-search dialog {
				inset-inline-start: 50% !important;
				inset-inline-end: auto !important;
				margin: 4rem 0 auto !important;
				transform: translateX(-50%);
			}
		}
	}
</style>

<script>
	import { MDCRipple } from '@material/ripple';

	const rippleSelector = [
		'.vis-nav a',
		'.section-link',
		'.download-button',
		'.pagination-links a',
		'.sidebar-content a',
		'.sidebar-content summary',
		'.sl-link-button',
		// 'site-search button[data-open-modal]',
		'starlight-theme-select select',
	].join(', ');

	document.querySelectorAll<HTMLElement>(rippleSelector).forEach((surface) => {
		surface.classList.add('mdc-ripple-surface');
		surface.style.setProperty('--mdc-ripple-color', 'var(--vis-orange)');
		MDCRipple.attachTo(surface);
	});
</script>
