---
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const baseRoot = base.replace(/\/$/, '');
const path = Astro.url.pathname.startsWith(baseRoot)
	? Astro.url.pathname.slice(baseRoot.length) || '/'
	: Astro.url.pathname;

const navItems = [
	{ label: '品牌规范', slug: 'brand' },
	{ label: '素材归档', slug: 'assets' },
	{ label: '应用规范', slug: 'guidelines' },
	{ label: '周边设计', slug: 'merch' },
];

const hrefFor = (slug: string) => `${base}${slug}/`;
const isActive = (slug: string) => path === `/${slug}` || path.startsWith(`/${slug}/`);
---

<div class="vis-header">
	<div class="vis-title sl-flex">
		<a class="vis-site-title" href={base} aria-label="南工问天 VIS 首页">
			<img class="vis-lockup vis-lockup-dark" src={`${base}assets/brand/team-lockup/队标加字反白.svg`} alt="南工问天 VIS" />
			<img class="vis-lockup vis-lockup-light" src={`${base}assets/brand/team-lockup/队标加字.svg`} alt="南工问天 VIS" />
			<span class="vis-title-divider" aria-hidden="true"></span>
			<span class="vis-title-system">视觉形象识别系统</span>
		</a>
	</div>
	<nav class="vis-nav" aria-label="主要导航">
		{navItems.map((item) => (
			<a class="mdc-ripple-surface" href={hrefFor(item.slug)} aria-current={isActive(item.slug) ? 'page' : undefined}>
				{item.label}
			</a>
		))}
	</nav>
	<div class="vis-tools sl-flex print:hidden">
		<Search />
		<div class="vis-theme"><ThemeSelect /></div>
	</div>
</div>

<style>
	@layer starlight.core {
		.vis-header {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr) auto;
			gap: clamp(0.75rem, 2vw, 2rem);
			align-items: center;
			height: 100%;
		}
		.vis-title { min-width: 0; }
		.vis-site-title { display: inline-flex; align-items: center; column-gap: 0.3em; width: auto; height: 2.75rem; min-width: 0; text-decoration: none; white-space: nowrap; }
		.vis-lockup { display: block; width: 11rem; height: 2.75rem; object-fit: contain; transform: translateY(-0.35rem); }
		.vis-lockup-light { display: none; }
		:global(:root[data-theme='light']) .vis-lockup-dark { display: none; }
		:global(:root[data-theme='light']) .vis-lockup-light { display: block; }
		.vis-title-divider { flex: 0 0 1px; width: 1px; height: 2.25rem; background: var(--vis-border-strong); transform: translateY(-0.35rem); }
		.vis-title-system { display: inline-flex; align-items: center; width: max-content; max-width: none; height: 2.75rem; color: var(--vis-header-muted); font-size: 1.05rem; font-weight: 700; line-height: 1.2; white-space: nowrap; transform: translateY(-0.35rem); }
		.vis-nav {
			display: flex;
			justify-content: center;
			gap: clamp(0.45rem, 1.6vw, 1.5rem);
			min-width: 0;
		}
		.vis-nav a {
			position: relative;
			padding: 0.45rem 0.15rem;
			color: var(--vis-header-muted);
			background-image: linear-gradient(var(--vis-orange), var(--vis-orange));
			background-repeat: no-repeat;
			background-position: center 100%;
			background-size: 0 2px;
			font-size: 0.84rem;
			font-weight: 700;
			text-decoration: none;
			white-space: nowrap;
			transition: color var(--vis-motion-fast) ease, background-size var(--vis-motion-fast) var(--vis-ease-out);
		}
		.vis-nav a:hover,
		.vis-nav a:focus-visible,
		.vis-nav a[aria-current='page'] { color: var(--vis-orange); }
		.vis-nav a:hover,
		.vis-nav a:focus-visible,
		.vis-nav a[aria-current='page'] { background-size: calc(100% - 0.3rem) 2px; }
		@media (hover: none) {
			.vis-nav a:hover:not([aria-current='page']) { color: var(--vis-header-muted); background-size: 0 2px; }
		}
		.vis-tools { gap: 0.75rem; align-items: center; }
		.vis-tools :global(site-search button[data-open-modal]) { color: var(--vis-header-muted); }
		@media (max-width: 72rem) {
			.vis-header { grid-template-columns: auto minmax(0, 1fr) auto; gap: 0.75rem; }
			.vis-nav { justify-content: flex-start; overflow-x: auto; scrollbar-width: none; }
			.vis-nav::-webkit-scrollbar { display: none; }
			.vis-theme { display: none; }
		}
		@media (max-width: 50rem) {
			.vis-header { grid-template-columns: minmax(0, 1fr) auto; padding-inline-start: calc(var(--sl-menu-button-size) + 0.75rem); }
			.vis-nav { grid-column: 1 / -1; grid-row: 2; justify-content: space-between; padding: 0.45rem 0 0.25rem;}
			.vis-tools { grid-column: 2; grid-row: 1; }
			.vis-title-divider { height: 2.25rem; }
		}
		@media (max-width: 30rem) {
			.vis-title-divider { height: 2.25rem; }
		}
	}
</style>

<script>
	import { MDCRipple } from '@material/ripple';

	const rippleSelector = [
		'.vis-nav a',
		'.section-link',
		'.download-button',
		'.pagination-links a',
		'.sidebar-content a',
		'.sidebar-content summary',
		'.sl-link-button',
		'site-search button[data-open-modal]',
		'starlight-theme-select select',
		'starlight-menu-button button',
	].join(', ');

	document.querySelectorAll<HTMLElement>(rippleSelector).forEach((surface) => {
		surface.classList.add('mdc-ripple-surface');
		surface.style.setProperty('--mdc-ripple-color', 'var(--vis-orange)');
		MDCRipple.attachTo(surface);
	});
</script>
