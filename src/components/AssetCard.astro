---
import DownloadButtons from './DownloadButtons.astro';
import { statSync } from 'node:fs';
import { join } from 'node:path';

interface Download {
	label: string;
	file: string;
	note?: string;
}

interface Props {
	title: string;
	preview?: string;
	fileType?: string;
	downloads?: Download[];
	previewTone?: 'light' | 'dark';
}

const {
	title,
	preview,
	fileType = '素材',
	downloads = [],
	previewTone = 'light',
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const resolveFile = (file: string) =>
	/^https?:\/\//.test(file) ? file : `${base}${file.replace(/^\/+/, '')}`;

// Read local asset timestamps during the build so cards stay current without frontmatter.
const sourceFile = downloads.find((download) => !/^https?:\/\//.test(download.file))?.file ?? preview;
let updatedDate = '';
if (sourceFile && !/^https?:\/\//.test(sourceFile)) {
	try {
		const assetPath = join(process.cwd(), 'public', sourceFile.replace(/^\/+/, ''));
		updatedDate = statSync(assetPath).mtime.toISOString().slice(0, 10);
	} catch {
		// A missing optional preview should not prevent the documentation build.
	}
}
---

<article class="asset-card">
	<div class:list={['asset-preview', previewTone]}>
		{preview ? (
			<img src={resolveFile(preview)} alt={`${title}预览`} loading="lazy" />
		) : (
			<div class="file-placeholder" aria-label={`${fileType}文件`}>
				<strong>{fileType}</strong>
				<span>源文件</span>
			</div>
		)}
	</div>
	<div class="asset-body">
		<div class="asset-heading">
			<div>
				<p class="asset-kicker">{fileType}</p>
				<h3>{title}</h3>
				{updatedDate && <p class="asset-meta">更新于 {updatedDate}</p>}
			</div>
		</div>
		<DownloadButtons downloads={downloads} />
	</div>
</article>

<style>
	.asset-card {
		display: grid;
		grid-template-columns: minmax(20rem, 68%) minmax(13rem, 32%);
		width: 100%;
		min-height: 22rem;
		margin-block: 1rem;
		overflow: hidden;
		border: 1px solid var(--vis-border);
		border-radius: 6px;
		background: var(--vis-panel);
	}
	.asset-preview {
		display: grid;
		place-items: center;
		min-height: 22rem;
		padding: 1.25rem;
		background: #fff;
	}
	.asset-preview.dark {
		background: var(--vis-carbon);
	}
	.asset-preview img {
		max-width: 100%;
		max-height: 19rem;
		object-fit: contain;
	}
	.file-placeholder {
		display: grid;
		gap: 0.25rem;
		place-items: center;
		width: 5.5rem;
		aspect-ratio: 1;
		border: 1px solid var(--vis-border-strong);
		color: var(--vis-teal);
		text-align: center;
	}
	.file-placeholder strong { font-size: 1.15rem; }
	.file-placeholder span { color: var(--vis-muted); font-size: 0.75rem; }
	.asset-body { display: flex; flex-direction: column; align-self: start; padding: 1.2rem 1.25rem 1.25rem; }
	.asset-kicker {
		margin: 0 0 0.25rem;
		color: var(--vis-orange);
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.asset-body h3 { margin: 0; font-size: 1.05rem; }
	.asset-meta { margin: 0.45rem 0 0; color: var(--vis-muted); font-size: 0.75rem; }
	.asset-body :global(.download-list) { margin-top: 1rem; }
	@media (max-width: 52rem) {
		.asset-card { grid-template-columns: 1fr; }
		.asset-preview { height: 16rem; min-height: 16rem; }
		.asset-preview img { max-height: 14rem; }
	}
</style>
